# Admin email: used to show Admin link and allow access to /admin. Must match backend ADMIN_EMAIL.
VITE_ADMIN_EMAIL=your-admin@example.com

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Single backend: dashboard + auth (run dashboard-backend/main.py). Required in production.
# Local:  http://localhost:34717
# Public: http://YOUR_SERVER_IP:34717
VITE_API_URL=http://localhost:34717

# Dashboard data: omit or true = mock data + "Coming soon" banner; set to false to show real dashboard.
# VITE_USE_MOCK_DASHBOARD=false
