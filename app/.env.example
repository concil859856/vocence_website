# Vocence website frontend
# Copy to app/.env

# API base URL (no trailing slash).
# Local dev (recommended): leave EMPTY so the app calls same-origin `/api/*` and Vite proxies
# to the backend (see vite.config.ts → server.proxy). Set VITE_DEV_API_PROXY if not using 8084.
# Production: set to your public API origin, e.g. https://api.vocence.ai
# VITE_API_URL=http://localhost:8084

# When VITE_API_URL is unset, Vite forwards /api to this URL (dashboard-backend).
VITE_DEV_API_PROXY=http://127.0.0.1:8084

# Google OAuth client for website login.
VITE_GOOGLE_CLIENT_ID=

# Admin email used to show the Admin page in the frontend.
VITE_ADMIN_EMAIL=

# Keep false for the real dashboard/backend.
VITE_USE_MOCK_DASHBOARD=false
