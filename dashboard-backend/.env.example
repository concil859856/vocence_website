# Admin email: used for blocklist, blog, validators, registered users (X-Admin-Email header).
# Must match the email used for admin login; set the same value as VITE_ADMIN_EMAIL in the app.
ADMIN_EMAIL=your-admin@example.com

# Port must match frontend VITE_API_URL (e.g. http://SERVER_IP:34717)
PORT=34717
# Or: DASHBOARD_PORT=34717

# Optional: JWT for auth (login, verify). Change in production.
# JWT_SECRET=your-secret-key-change-in-production

# Database (same as Vocence owner DB)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=vocence
# POSTGRES_PASSWORD=vocence
# POSTGRES_DB=vocence
# Or: DATABASE_URL=postgresql://user:pass@host:5432/vocence

# Studio TTS: Chutes (call miner) and Hippius (upload WAV, 7-day retention).
# Chutes: GET api.chutes.ai/chutes/{id} for slug; POST https://{slug}.chutes.ai/speak (Bearer token).
# Hippius: same as Vocence owner — s3.hippius.com, secure, region=decentralized.
# CHUTES_BASE_URL=https://api.chutes.ai
# CHUTES_API_KEY=your-chutes-api-key
# HIPPIUS_OWNER_ACCESS_KEY=your-hippius-owner-key
# HIPPIUS_OWNER_SECRET_KEY=your-hippius-owner-secret
# HIPPIUS_ENDPOINT=s3.hippius.com
# STUDIO_TTS_BUCKET=studio-tts
# STUDIO_TTS_EXPIRY_DAYS=7
