# =============================================================================
# Vocence Dashboard Backend – .env.example
# Copy to .env and fill in values. Required vs optional is noted below.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED – Dashboard and database
# -----------------------------------------------------------------------------

# Admin email for protected routes (blocklist, blog, validators, users).
# Must match VITE_ADMIN_EMAIL in the app if you use admin login.
ADMIN_EMAIL=your-admin@example.com

# Port the backend listens on. Frontend VITE_API_URL must point here (e.g. http://localhost:34717).
PORT=34717

# PostgreSQL – same database as Vocence owner API (registered_miners, performance_metrics, etc.).
# Either set DATABASE_URL or all of POSTGRES_*.
DATABASE_URL=postgresql://vocence:vocence@localhost:5432/vocence
# Or individually:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=vocence
# POSTGRES_PASSWORD=vocence
# POSTGRES_DB=vocence

# -----------------------------------------------------------------------------
# REQUIRED for Studio TTS (calling miners + storing WAV)
# -----------------------------------------------------------------------------

# Chutes API key – must be allowed to call miners’ /speak (same as for validators).
# Without this, Studio TTS will return 502 when generating.
# (Code also accepts CHUTES_AUTH_KEY.)
CHUTES_API_KEY=your-chutes-api-key

# Hippius S3 (owner credentials) – upload generated WAV and presigned URLs.
# Without this, TTS generation will fail after the miner returns audio.
# (Code also accepts HIPPIUS_ACCESS_KEY / HIPPIUS_SECRET_KEY.)
HIPPIUS_OWNER_ACCESS_KEY=your-hippius-owner-access-key
HIPPIUS_OWNER_SECRET_KEY=your-hippius-owner-secret-key

# -----------------------------------------------------------------------------
# OPTIONAL – Override defaults
# -----------------------------------------------------------------------------

# JWT secret for auth (login/verify). Change in production.
# JWT_SECRET=your-secret-key-change-in-production

# CORS: comma-separated origins, or leave unset for allow_origins=["*"].
# CORS_ORIGIN=https://vocence.ai,https://www.vocence.ai

# Main validator hotkey for dashboard “main” rankings and Studio top models.
# If unset, first validator in DB is used.
# LIVE_VALIDATION_MAIN_VALIDATOR_HOTKEY=5xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chutes API base (default: https://api.chutes.ai).
# CHUTES_BASE_URL=https://api.chutes.ai

# Hippius S3 endpoint (default: s3.hippius.com).
# HIPPIUS_ENDPOINT=s3.hippius.com

# Studio TTS bucket and retention (defaults: studio-tts, 7 days).
# STUDIO_TTS_BUCKET=studio-tts
# STUDIO_TTS_EXPIRY_DAYS=7

# Alternate port env name (default: PORT).
# DASHBOARD_PORT=34717

# Enable auto-reload (default: false).
# RELOAD=true

# Local SQLite path for website DB (e.g. registered users). Default: data/website.db.
# SQLITE_PATH=./data/website.db
