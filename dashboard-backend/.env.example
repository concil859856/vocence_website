# Vocence website backend
# Copy to dashboard-backend/.env

# Service
PORT=8084
# Optional alternative to PORT:
# DASHBOARD_PORT=8084

# Security / auth
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=

# CORS
# Set to your real frontend origin in production.
# Example: CORS_ORIGIN=https://app.vocence.ai
CORS_ORIGIN=http://localhost:5173

# Product defaults
SIGNUP_CREDITS=50
SQLITE_PATH=/workspace/vocence_website/dashboard-backend/data/website.db

# Owner / subnet PostgreSQL
# Same Vocence owner DB used for miners, validators, evaluations, graph activity, etc.
DATABASE_URL=postgresql://vocence:vocence@localhost:5432/vocence

# Live validation / ranking context
LIVE_VALIDATION_MAIN_VALIDATOR_HOTKEY=
OWNER_HOTKEY=

# Chutes / Hippius for Studio TTS and uploads
CHUTES_API_KEY=
HIPPIUS_OWNER_ACCESS_KEY=
HIPPIUS_OWNER_SECRET_KEY=

# Studio models (frontend / Studio page only). API traffic uses developer-api
# API_TTS_PROVIDER_<N>_CHUTE_SLUG — see developer-api/.env.example.
# Studio models shown on website (env-configured; supports multiple entries)
# The Studio page displays exactly the configured models below.
# Add/remove numbered groups (1,2,3,...) to control how many models appear.
# Example:
# STUDIO_MODEL_1_NAME=PromptTTS Alpha
# STUDIO_MODEL_1_CHUTE_SLUG=vocence-prompttts-alpha
# STUDIO_MODEL_1_CHUTE_ID=chute_abc123      # optional
# STUDIO_MODEL_1_MINER_HOTKEY=website-alpha # optional
STUDIO_MODEL_1_NAME=
STUDIO_MODEL_1_CHUTE_SLUG=
STUDIO_MODEL_1_CHUTE_ID=
STUDIO_MODEL_1_MINER_HOTKEY=
STUDIO_MODEL_2_NAME=
STUDIO_MODEL_2_CHUTE_SLUG=
STUDIO_MODEL_2_CHUTE_ID=
STUDIO_MODEL_2_MINER_HOTKEY=

# Stripe (server-side checkout via /api/payments/checkout-session)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret must be from the webhook endpoint whose URL matches where Stripe POSTs
# (Dashboard → Developers → Webhooks → your endpoint → Reveal secret). Test vs live keys must match.
# If webhooks return 400 Invalid signature, the secret or URL/mode (test/live) is wrong.
# Optional: STRIPE_WEBHOOK_TOLERANCE_SECONDS=600  # if server clock skew causes timestamp errors
# STRIPE_SUCCESS_URL=https://www.vocence.ai/account?tab=credits&checkout=success
# STRIPE_CANCEL_URL=https://www.vocence.ai/pricing?checkout=cancel
#
# Normal/Premium: one-time Prices only → Checkout `payment` mode (pricing_plans.billing_type is not subscription).
# Normal pack is $12 / 4,000 credits in app DB — create matching one-time Price in Stripe for STRIPE_PRICE_ID_NORMAL.
# Crypto (NOWPayments) list price/credits come from pricing_plans.crypto_price_usd / crypto_credits_included when set (e.g. $20/7k Normal, $40/16k Premium); Stripe ignores those columns.
STRIPE_PRICE_ID_NORMAL=
STRIPE_PRICE_ID_PREMIUM=

# Optional checkout URLs used by the pricing page.
# If these are unset, checkout sessions are created but will return
# "pending configuration" instead of redirecting.
STRIPE_CHECKOUT_URL_NORMAL=
STRIPE_CHECKOUT_URL_PREMIUM=
CRYPTO_CHECKOUT_URL=
CRYPTO_CHECKOUT_URL_NORMAL=
CRYPTO_CHECKOUT_URL_PREMIUM=

# NOWPayments (recommended for live crypto checkout + webhook auto-crediting)
# If NOWPAYMENTS_API_KEY is set, crypto checkout creates a NOWPayments invoice URL dynamically.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
# Set this to your public backend URL and register the same URL in NOWPayments dashboard.
NOWPAYMENTS_IPN_CALLBACK_URL=https://backend.vocence.ai/api/payments/nowpayments/webhook
NOWPAYMENTS_SUCCESS_URL=https://www.vocence.ai/account?tab=credits&checkout=success
NOWPAYMENTS_CANCEL_URL=https://www.vocence.ai/pricing?checkout=cancel
# Optional preferred pay currencies (defaults to usdttrc20)
NOWPAYMENTS_PAY_CURRENCY_DEFAULT=usdttrc20
NOWPAYMENTS_PAY_CURRENCY_NORMAL=usdttrc20
# If your main payout wallet is Tron USDT, prefer usdttrc20 here too (avoids swaps / higher minimums).
NOWPAYMENTS_PAY_CURRENCY_PREMIUM=usdttrc20
# Comma-separated payment statuses that should apply credits
NOWPAYMENTS_SUCCESS_STATUSES=finished,confirmed
#
# Invoice / "amountTo too small" + "currency unavailable" (NOWPayments hosted checkout):
# NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20   # MAIN payout wallet ticker (must match dashboard)
# NOWPAYMENTS_IS_FEE_PAID_BY_USER=true   # default true — customer pays fees
# NOWPAYMENTS_IS_FIXED_RATE=false        # default false — floating rate often fixes TRX "unavailable"
#
# Invoice USD (same credits always): dynamic sizing calls NP /min-amount + /estimate so you pay the
# minimum extra USD needed (often ~$0.50–3 over list), not a flat $6. Optional addons:
# NOWPAYMENTS_USE_DYNAMIC_INVOICE_USD=true   # default true; set false to use flat buffer only
# NOWPAYMENTS_DYNAMIC_RESOLVE_FUDGE=1.02    # multiply each resolve step (NP rounding)
# NOWPAYMENTS_INVOICE_BUFFER_USD=0         # optional EXTRA USD after dynamic resolve (e.g. 0.25 for comfort)
# NOWPAYMENTS_LEGACY_FLAT_BUFFER_USD=0    # only when USE_DYNAMIC_INVOICE_USD=false — old "add $6" style
# NOWPAYMENTS_MIN_INVOICE_USD=0
# NOWPAYMENTS_VALIDATE_EXTRA_CURRENCIES=
# User-selectable pay currencies on pricing (comma list of NP tickers). If unset, options default to the same set as
# pre-validation (e.g. usdttrc20 + usdterc20 when VALIDATE_EXTRA is empty).
# NOWPAYMENTS_SELECTABLE_PAY_CURRENCIES=usdttrc20,usdterc20,usdtmatic,usdtarc20
# NOWPAYMENTS_INVOICE_OMIT_PAY_CURRENCY=false
# NOWPAYMENTS_SKIP_MIN_AMOUNT_CHECK=false

# Developer API pricing and rate-limits (for api.vocence.ai service rollout)
API_PRICE_USD_PER_1M_CHARS=10
API_CREDITS_PER_1M_CHARS=2000
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=4

# Sales contact email delivery (required for /api/sales/contact)
SALES_EMAIL_TO=space@vocence.ai
#
# Option A — Resend (HTTPS API, easiest if Microsoft 365 blocks SMTP AUTH):
#   https://resend.com — create API key, verify domain (or use onboarding@resend.dev for tests).
#   If RESEND_API_KEY is set, SMTP below is ignored for sales form.
RESEND_API_KEY=
RESEND_FROM=Vocence <onboarding@resend.dev>
#
# Option B — Classic SMTP (often blocked on M365 tenants: SmtpClientAuthentication disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
