# =============================================================================
# NEW ENV VARS introduced on the `ops` branch since last prod sync.
# Generated by the autonomous test sprint. Review each block, set the
# values that match your deployment, then append to your real .env.
#
# Everything below has a safe in-code default — leaving a var unset
# usually means "use the in-code default", NOT "crash at startup".
# The exceptions are FLAGGED with **REQUIRED**.
# =============================================================================

# -----------------------------------------------------------------------------
# Voice pipeline mode — THE BIG SWITCH.
# `next` enables voice_pipeline_next.py (the framework-based pipeline
# the recent work targets). `legacy` keeps the old voicechat_stream.py
# path. Anything else also falls back to legacy.
#
# Default if unset: legacy. To pick up the new pipeline (recording
# fixes, barge-in fixes, agent.calls() SDK surface): set to `next`.
# -----------------------------------------------------------------------------
VOICE_PIPELINE=next

# -----------------------------------------------------------------------------
# Deepgram STT (currently DISABLED in product per user request, but
# the env vars still exist so re-enabling is one flag flip).
# Set VOICE_STT_ALLOW_DEEPGRAM=1 to allow agents whose stt_provider
# is "deepgram" to actually use it. Default 0 (forces all sessions
# to Vocence STT regardless of agent config).
# -----------------------------------------------------------------------------
VOICE_STT_ALLOW_DEEPGRAM=0
# DEEPGRAM_API_KEY=                  # only needed if you flip the flag above
# DEEPGRAM_MODEL=nova-2              # default nova-2; nova-3 is newer but flaky in our config
# DEEPGRAM_ENDPOINTING_MS=50         # silence threshold for end-of-utterance

# -----------------------------------------------------------------------------
# Google Gemini LLM (used by some agents' llm_model selection).
# Multi-key rotation supported via GOOGLE_API_KEYS (comma-sep), or
# single key via GOOGLE_API_KEY. Cooldown handles 429s gracefully.
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=                    # OR
# GOOGLE_API_KEYS=key1,key2,key3     # pool with round-robin + per-key cooldown
# GOOGLE_BASE_URL=                   # only set if using a proxy
# GOOGLE_MODEL=gemini-2.5-flash      # default
# GOOGLE_KEY_COOLDOWN_SEC=60         # how long to back off a 429'd key

# -----------------------------------------------------------------------------
# Architect chat (the LLM that powers the agent-builder side drawer).
# Defaults reasonable, override only if you want a different model.
# -----------------------------------------------------------------------------
# ARCHITECT_LLM_MODEL=gpt-5          # default
# ARCHITECT_REASONING_EFFORT=high    # high|medium|low
# ARCHITECT_TIMEOUT_SEC=120

# -----------------------------------------------------------------------------
# Server-side barge-in tuner (legacy pipeline only; new pipeline has
# its own InterruptConfig). Defaults work; only touch if you're seeing
# false-positive interrupts from speaker bleed.
# -----------------------------------------------------------------------------
# VOICE_SERVER_BARGE_IN=1            # 1=on, 0=off
# BARGE_IN_RMS_THRESHOLD=0.02
# BARGE_IN_REQUIRED_FRAMES=3
# BARGE_IN_IGNORE_WINDOW_MS=80

# -----------------------------------------------------------------------------
# Recording — gap compression for the stereo WAV. Inter-turn silences
# longer than this get compressed to the cap. Default 400ms keeps the
# playback listenable without losing rhythm.
# -----------------------------------------------------------------------------
# RECORDING_MAX_GAP_MS=400
# OPS_CALL_RECORDING_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Voicechat tuning — defaults work, only set if you're tuning latency
# vs cost on a specific deployment.
# -----------------------------------------------------------------------------
# VOICECHAT_TTS_POD_MAX_CHARS=900    # split bigger replies onto multiple speak calls
# VOICECHAT_SINGLE_CALL_TTS=0
# VOICECHAT_WHOLE_REPLY_THRESHOLD=300
# VOICECHAT_SUMMARY_MODEL=

# -----------------------------------------------------------------------------
# VIDEO DUBBING (Studio → Video Dubbing, /v1/video/dub)
#
# Two tiers, each served by a different upstream engine:
#   standard  = translate + revoice, speaker's voice preserved, video untouched
#   lipsync   = the above, plus the speaker's mouth re-rendered to match
#
# A tier with no key configured is reported as unavailable by
# GET /video-dub/languages and its option is disabled in the UI —
# the feature degrades rather than failing at submit time.
#
# **REQUIRED for the standard tier** (already set if Studio dubbing is live):
# ELEVENLABS_API_KEY=
#
# **REQUIRED for the lipsync tier** — without it the checkbox is disabled:
# HEYGEN_API_KEY=
# -----------------------------------------------------------------------------

# Pricing. Rates are quoted per minute but billed PER SECOND, PER TARGET
# LANGUAGE — matching the upstreams, which bill per second with no minimum
# (verified against the live API 2026-07-21: a 6.0s clip cost exactly $0.20).
#
# Set at COST PARITY — we charge what the upstream charges us, at the 400
# credits/$ crypto rate:
#     200 cr/min = $0.50/min   standard
#     800 cr/min = $2.00/min   lip-sync
#
# This is a zero-margin setting. Storage, egress and refunded failed jobs are
# not recovered, so the real position is marginally negative. Raise these two
# numbers to introduce margin — nothing else needs changing.
#
# Mirror any change in app/src/studio/creditCosts.ts. The UI also calls
# /video-dub/quote, so the displayed price follows the server automatically,
# but the pre-quote estimate comes from the frontend constants.
# STUDIO_VIDEO_DUB_CREDITS_PER_MIN=200
# STUDIO_VIDEO_DUB_LIPSYNC_CREDITS_PER_MIN=800

# Cost containment. Every minute of lipsync is real upstream spend, so the
# defaults are deliberately far below what the engines themselves accept.
# STUDIO_VIDEO_DUB_MAX_DURATION_SEC=600        # 10 min per video
# STUDIO_VIDEO_DUB_MAX_LANGUAGES=3             # per job
# STUDIO_VIDEO_DUB_MAX_UPLOAD_BYTES=209715200  # 200 MB
# UPLOAD_VIDEO_DUB_SOURCE_MAX_BYTES=209715200  # must be >= the above

# The lipsync engine's own source limits are tighter than ours. Sources over
# these are rejected at submit — before any charge — rather than failing
# upstream after we've billed the user.
# STUDIO_VIDEO_DUB_LIPSYNC_MAX_BYTES=104857600 # 100 MB
# STUDIO_VIDEO_DUB_LIPSYNC_MAX_DIM=2048        # longest side; engine rejects >2K

# Free-plan lip-sync length cap, in seconds. Lip-sync is the expensive tier,
# and 300 signup credits would otherwise buy ~22s of it, so free accounts get
# a short trial clip only. Standard dubbing is uncapped on every plan (gated
# by credits alone). Premium lip-sync is uncapped. 0 disables the cap.
# STUDIO_VIDEO_DUB_LIPSYNC_FREE_MAX_SEC=10

# Max concurrent dubbing jobs across the whole deployment. This is the main
# lever on worst-case upstream spend — there is no pod pool bounding it.
# Set to 0 to disable the feature entirely.
# STUDIO_VIDEO_DUB_CONCURRENCY=4

# Per-language wait on the upstream engine before the job is failed and
# refunded. Lipsync re-renders every frame, so keep this generous.
# LB_PHASE_TIMEOUT_VIDEO_DUB=1800

# -----------------------------------------------------------------------------
# Misc operator knobs — defaults all fine; listed here so they exist
# if you want to override.
# -----------------------------------------------------------------------------
# LOGOS_FREE_MAX_SESSION_SEC=180     # free Logos cap
# MIN_DELAY_MS=200
# MAX_DELAY_MS=2000
# AUDIO_CONTINUE=
# CONF_MID=
# TEXT_SLOPE=
# W_AUDIO=
# W_TEXT=
# OPS_WEBHOOK_DELIVERY_INTERVAL_S=3.0
# OPS_WEBHOOK_DELIVERY_BATCH_SIZE=32
# TD_BATCH_TIMEOUT_SEC=
# ULTRAVAD_CLIENT_CONNECT_TIMEOUT_SEC=
# ULTRAVAD_CLIENT_SOCK_READ_TIMEOUT_SEC=
# DENOISER_CLIENT_CONNECT_TIMEOUT_SEC=
# DENOISER_CLIENT_SOCK_READ_TIMEOUT_SEC=
# VOICE_DRAIN_TIMEOUT_S=
# WEBHOOKS_ALLOW_HTTP=0              # 1 to allow non-HTTPS webhook URLs (dev only)
# VOCENCE_PII_REDACTION=0            # 1 to enable PII redaction on stored transcripts
# STT_PROVIDER=vocence               # default at the request-level (per-agent overrides)
