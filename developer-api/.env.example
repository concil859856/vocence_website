# ============================================================================
# Vocence Developer API — environment configuration
# ============================================================================
# Copy this file to ``.env`` and fill in the values marked REQUIRED.
# Everything else has a sensible default and can stay commented out.
#
# Two layers run in production:
#   1. dashboard-backend (port 8084)  — owns the DB, payments, GPU pools,
#      voice-agent pipeline. Must be running BEFORE the dev-api can serve
#      any voice-agent / streaming WS endpoint (those proxy to it).
#   2. developer-api (this app, port 8085) — externally-facing /v1/* API
#      that customers hit with their voc_live_... key.
#
# For local dev with no public traffic you can use the same SQLite file
# the dashboard-backend writes to (default in SQLITE_PATH below).
# ============================================================================


# ---------- Process ----------
PORT=8085

# Shared SQLite DB with dashboard-backend. Both processes read/write
# the same file; dashboard-backend owns the schema migrations.
SQLITE_PATH=/workspace/vocence_website/dashboard-backend/data/website.db


# ============================================================================
# REQUIRED for any inference
# ============================================================================

# Chutes / GPU provider auth header. Used for TTS + STT calls.
# Get from https://chutes.ai → API Keys.
CHUTES_API_KEY=

# At least one TTS provider must be configured for PromptTTS to work.
# Set CHUTE_SLUG to the chute id you've deployed (e.g. "qwen-tts-3-mini").
API_TTS_PROVIDER_1_NAME=PromptTTS API
API_TTS_PROVIDER_1_CHUTE_SLUG=
API_TTS_PROVIDER_1_ENABLED=true
API_TTS_PROVIDER_1_WEIGHT=100
# Add a second row to load-balance:
# API_TTS_PROVIDER_2_NAME=PromptTTS API
# API_TTS_PROVIDER_2_CHUTE_SLUG=second-chute-slug
# API_TTS_PROVIDER_2_WEIGHT=50

# STT — fixed public Whisper endpoint on Chutes.
CHUTES_WHISPER_STT_URL=https://chutes-whisper-large-v3.chutes.ai/transcribe


# ============================================================================
# REQUIRED for voice-agent + streaming WS proxying
# ============================================================================

# WS URL of the dashboard-backend's voice pipeline. The dev-api just
# forwards /v1/agents/{id}/session and the streaming TTS/STT WS
# endpoints here, adding the trust headers. For local dev this is
# the dashboard's own host:port (default 8084) on the loopback.
DASHBOARD_VOICECHAT_WS_URL=ws://127.0.0.1:8084/api/dashboard/voicechat/session

# Shared secret between dev-api and dashboard-backend. MUST match the
# value on the dashboard side. Use 32+ chars of random — anyone with
# this value can impersonate any user against the dashboard.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=


# ============================================================================
# REQUIRED for voice clone + voice design save endpoints
# ============================================================================
# The voice-clone helper lives in dashboard-backend and is reached
# either by the same proxy as TTS (cheaper, recommended) or by a
# direct chute call (legacy). Pick ONE.

# Direct chute mode (legacy):
# STUDIO_VOICE_CLONE_URL=https://my-clone-chute.chutes.ai
# STUDIO_VOICE_CLONE_API_KEY=
# STUDIO_VOICE_CLONE_CHUTE_SLUG=
# STUDIO_VOICE_CLONE_PATH=/clone
# STUDIO_VOICE_CLONE_REQUEST_MODE=form_file   # or json
# STUDIO_VOICE_CLONE_REF_FILENAME=reference.wav
# STUDIO_VOICE_CLONE_REF_CONTENT_TYPE=audio/wav
# STUDIO_VOICE_CLONE_KEY_REF_AUDIO=reference_audio
# STUDIO_VOICE_CLONE_KEY_REF_TEXT=ref_text
# STUDIO_VOICE_CLONE_KEY_TARGET=target_text
# STUDIO_VOICE_CLONE_TIMEOUT_SEC=300


# ============================================================================
# REQUIRED for music generation endpoint
# ============================================================================
# MUSIC_GEN_API_URL=
# MUSIC_GEN_TIMEOUT_SEC=300


# ============================================================================
# Object storage (audio uploads)
# ============================================================================
# Provider: "r2" (default, Cloudflare R2) or "hippius" (legacy).
BUCKET_PROVIDER=r2

# --- Cloudflare R2 (default) ---
# Account id is the 32-char hex in your R2 dashboard URL.
# Generate API tokens at R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vocence-audio
# Public CNAME mapped to the bucket. Leave blank to fall back to
# 5-year presigned URLs.
R2_PUBLIC_DOMAIN=audio.vocence.ai

# --- Hippius S3 (legacy — only when BUCKET_PROVIDER=hippius) ---
# HIPPIUS_OWNER_ACCESS_KEY=
# HIPPIUS_OWNER_SECRET_KEY=
# HIPPIUS_ENDPOINT=s3.hippius.com

# Bucket + TTL for uploaded audio (same names dashboard-backend uses).
STUDIO_TTS_BUCKET=studio-tts
STUDIO_TTS_EXPIRY_DAYS=7


# ============================================================================
# Billing + rate limits (have sane defaults)
# ============================================================================

# Per-million-char rate for TTS (4000 cr / 1M chars = $10 / 1M at our default rate).
API_CREDITS_PER_1M_CHARS=4000
API_PRICE_USD_PER_1M_CHARS=10
# Default voice style when caller omits style_instruction.
API_DEFAULT_STYLE_INSTRUCTION=neutral voice
# Set > 0 to switch from per-char billing to a flat per-request charge.
API_TTS_CREDITS_PER_REQUEST=0

# STT pricing (clip-based).
API_STT_CREDITS_COST=15
API_STT_CREDITS_PER_MIN=3
API_STT_MAX_AUDIO_BYTES=52428800
API_STT_MAX_DURATION_SEC=300

# Voice clone (per-call).
API_CLONE_CREDITS_PER_1M_CHARS=4000
API_CLONE_MAX_REF_AUDIO_BYTES=52428800
API_VOICE_CLONE_CREDITS=0

# Voice design (per-preview / per-save).
API_VOICE_DESIGN_CREDITS=70
API_VOICE_SAVE_CREDITS=20

# Noise remover (per-call) + legacy "dubbing" alias.
API_NOISE_REMOVER_CREDITS_COST=5
API_NOISE_REMOVER_MAX_AUDIO_BYTES=52428800
API_NOISE_REMOVER_MAX_DURATION_SEC=300
# Aliases — kept for back-compat. Leave commented to inherit from
# the NOISE_REMOVER vars above.
# API_DUBBING_CREDITS_COST=5
# API_DUBBING_MAX_AUDIO_BYTES=52428800

# Music (per-generation).
API_MUSIC_CREDITS_PER_REQUEST=30

# Knowledge ingest (PDF parsing — others are free).
API_KNOWLEDGE_PDF_CREDITS=20

# Per-account rate limit (sliding 60-second window). Hard ceiling
# regardless of plan; raise per-key on the dashboard for trusted
# accounts. ``API_RATE_LIMIT_ENABLED=false`` disables the cap.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=4

# ─────────────────────────────────────────────────────────────────────
# OKX AI Marketplace (A2MCP ASP) — app/okx. All optional; the surface
# stays dark until set. Full runbook: app/okx/README.md
# ─────────────────────────────────────────────────────────────────────
# OKX_PAY_TO_ADDRESS=          # Agentic Wallet EVM address (receives funds)
# OKX_API_KEY=                 # OKX Developer Portal (web3.okx.com/onchainos/dev-portal)
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# OKX_NETWORK=eip155:1952      # X Layer TESTNET default; prod = eip155:196
# OKX_SYNC_SETTLE=1
# OKX_ASSET_ADDRESS=           # settlement token; REQUIRED on testnet (no SDK default), leave unset on mainnet (USD₮0)
# OKX_ASSET_DECIMALS=6
# OKX_ASSET_NAME=USDT
# OKX_ASSET_VERSION=1
# OKX_SYSTEM_API_KEY=          # a funded voc_live_ key; fulfillment executor
# OKX_SELF_API_BASE=http://127.0.0.1:8031
# OKX_PRICE_TTS=$0.02
# OKX_PRICE_STT=$0.02
# OKX_PRICE_VOICE_DESIGN=$0.10
# OKX_PRICE_VOICE_CLONE=$0.05
# OKX_PRICE_NOISE_REMOVER=$0.02
# OKX_PRICE_VIDEO_DUB_PER_MIN=$0.60
# OKX_PRICE_VIDEO_DUB_LIPSYNC_PER_MIN=$2.40
