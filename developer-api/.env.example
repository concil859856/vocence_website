PORT=8085
SQLITE_PATH=/workspace/vocence_website/dashboard-backend/data/website.db

# Chutes + Hippius
CHUTES_API_KEY=
HIPPIUS_OWNER_ACCESS_KEY=
HIPPIUS_OWNER_SECRET_KEY=
HIPPIUS_ENDPOINT=s3.hippius.com
STUDIO_TTS_BUCKET=studio-tts
STUDIO_TTS_EXPIRY_DAYS=7

# API TTS chutes (developer-api only). Separate from dashboard STUDIO_MODEL_*.
# If any API_TTS_PROVIDER_<N>_NAME is set, only those vars are read (Studio is never used).
# Multiple rows with the same NAME spread traffic via WEIGHT (weighted random).
API_TTS_PROVIDER_1_NAME=PromptTTS API
API_TTS_PROVIDER_1_CHUTE_SLUG=
API_TTS_PROVIDER_1_ENABLED=true
API_TTS_PROVIDER_1_WEIGHT=100
# API_TTS_PROVIDER_2_NAME=PromptTTS API
# API_TTS_PROVIDER_2_CHUTE_SLUG=second-chute-slug
# API_TTS_PROVIDER_2_WEIGHT=50

# Legacy alias (used only when no API_TTS_PROVIDER_*_NAME keys exist):
# TTS_PROVIDER_1_NAME=...
# TTS_PROVIDER_1_CHUTE_SLUG=...

# Billing + limits
API_PRICE_USD_PER_1M_CHARS=10
API_CREDITS_PER_1M_CHARS=2000
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=4
