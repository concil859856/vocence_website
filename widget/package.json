{
  "name": "@vocence/widget",
  "version": "0.1.0",
  "description": "Embeddable voice-agent widget for Vocence. One-line <vocence-agent> Web Component for any website.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/widget.iife.js",
  "module": "./dist/widget.esm.js",
  "types": "./dist/widget.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.esm.js",
      "default": "./dist/widget.iife.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "size": "node scripts/check-size.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
